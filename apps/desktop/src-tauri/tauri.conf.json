{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freeRGB",
  "version": "0.1.0",
  "identifier": "org.freergb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "freeRGB",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing --in-process-gpu --enable-features=NetworkServiceInProcess,NetworkServiceInProcess2 --disable-background-networking --disable-component-update --disable-sync --no-first-run"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../assets/icons/freergb-32.png",
      "../../../assets/icons/freergb-128.png",
      "../../../assets/icons/freergb.ico",
      "../../../assets/icons/freergb.png"
    ]
  }
}
