# freeRGB udev rules
#
# Grants the logged-in user (via systemd-logind "uaccess") read/write access to
# the hidraw nodes of devices freeRGB can drive, so the daemon does not need
# root. Install:
#
#   sudo install -m 0644 60-freergb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Only devices with an implemented adapter are listed. Merely identified
# devices are not, because freeRGB never writes to them.

# Corsair K70 CORE RGB (Bragi protocol)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1bfd", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="1bff", TAG+="uaccess"

# Corsair iCUE LINK System Hub (experimental, opt-in via --enable-link-hub)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c3f", TAG+="uaccess"

# Motherboard RGB/ARGB controllers on the internal USB header (docs/MAINBOARD_RGB.md)
# ASUS Aura motherboard USB
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18f3", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1939", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="19af", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1aa6", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1bed", TAG+="uaccess"
# Gigabyte RGB Fusion 2 USB (ITE IT5702/IT8297)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="5702", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="8297", TAG+="uaccess"
# ASRock Polychrome USB
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="01a2", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="01a6", TAG+="uaccess"

# Motherboard fan headers through kernel hwmon (docs/COOLING_LINUX_HWMON.md).
# sysfs attributes cannot use uaccess; members of group "freergb" may write
# pwmN/pwmN_enable. Create the group and add yourself once:
#   sudo groupadd -r freergb && sudo usermod -aG freergb "$USER"   (then log in again)
# Only SuperIO/EC fan drivers are listed; CPU/GPU/NVMe sensors stay read-only.
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="nct6*|nct5*|it87*|it86*|it88*|f71*|f81*|w83*|nct7*|asus_wmi_sensors|asus-ec-sensors|dell_smm|thinkpad|gigabyte_wmi|sch5627|sch5636|pc87*|smsc47m*|vt1211|lm85|adt7*|emc*", \
  RUN+="/bin/sh -c 'for f in /sys%p/pwm[0-9]* ; do [ -f \"$f\" ] && chgrp freergb \"$f\" && chmod g+w \"$f\"; done'"
